# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Native build outputs. Libraries in game/bin/ are built and committed by GitHub Actions
# (.github/workflows/build-sim.yml); local builds stay out of git.
native/**/*.o
native/**/*.os
native/**/*.obj
native/.sconsign*.dblite
native/.scons-cache/
game/bin/libunholy_sim.*
game/bin/*.lib
game/bin/*.exp
game/bin/*.pdb
native/build/
