; Engine configuration file.
; Godot 4.7. Open this folder (game/) in the Godot editor.

config_version=5

[application]

config/name="Unholy Assembly"
config/description="Bringing Eternal Life to a Village Near You, Since 1197."
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Events="*res://autoload/events.gd"
GameState="*res://autoload/game_state.gd"
Sim="*res://autoload/sim.gd"
Jobs="*res://lair/jobs.gd"
Narrative="*res://eyegor/narrative.gd"
Threats="*res://threats/threat_director.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.043, 0.035, 0.047, 1)
